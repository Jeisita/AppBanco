
/* =================================
   DETALLES VISUALES ROSE CAFÉ
================================= */

/* Encabezados de página */

.page-header h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

.page-header p {
    color: var(--cafe);
    opacity: 0.85;
}

/* Tarjetas con efecto suave */

.card {
    transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
    box-shadow: 0 6px 18px rgba(139, 101, 88, 0.15);
}

/* Tablas adaptables */

.card {
    overflow-x: auto;
}

table {
    min-width: 550px;
}

/* Formularios dentro de tablas */

td form {
    min-width: 150px;
}

td select {
    min-width: 130px;
}

/* Prioridades */

.prioridad-alta {
    background: #F3D2CC;
    color: #934D40;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.prioridad-media {
    background: #F2E5D2;
    color: #8B6558;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.prioridad-baja {
    background: #F7E9E7;
    color: #A87569;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

/* Estados de tickets */

.estado-abierto {
    background: #F3D2CC;
    color: #934D40;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.estado-proceso {
    background: #F2E5D2;
    color: #8B6558;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.estado-resuelto {
    background: #E7EDE3;
    color: #58734F;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

/* Pie de página */

footer {
    margin-top: 35px;
    padding: 15px;
    text-align: center;
    color: var(--cafe);
    opacity: 0.75;
    font-size: 13px;
}

/* Menú lateral */

.sidebar {
    box-shadow: 3px 0 12px rgba(139, 101, 88, 0.06);
}

.sidebar h2 {
    font-size: 21px;
}

/* Espaciado de botones */

button {
    margin-top: 5px;
}

/* Ajustes para móviles */

@media (max-width: 700px) {
    .sidebar {
        box-shadow: none;
    }

    .sidebar nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .sidebar a {
        margin: 4px;
    }

    .page-header h1 {
        font-size: 24px;
    }
}
