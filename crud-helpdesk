
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorías - HelpDesk Lite</title>

    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>☕ HelpDesk Lite</h2>

            <nav>
                <a href="/">⌂ Inicio</a>
                <a href="/usuarios">♙ Usuarios</a>
                <a href="/categorias" class="active">▤ Categorías</a>
                <a href="/tickets">▣ Tickets</a>
            </nav>
        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Gestión de categorías</h1>
                <p>Organiza los tipos de incidentes de soporte técnico.</p>
            </header>

            <section class="card">
                <h2>Crear categoría</h2>

                {% if error %}
                    <div class="alert">{{ error }}</div>
                {% endif %}

                <form method="POST">

                    <label>Nombre de la categoría:</label>
                    <input
                        type="text"
                        name="nombre"
                        placeholder="Ej. Hardware, Software, Redes..."
                        required
                    >

                    <label>Descripción:</label>
                    <textarea
                        name="descripcion"
                        rows="4"
                        placeholder="Describe brevemente esta categoría"
                    ></textarea>

                    <button type="submit">Guardar categoría</button>

                </form>
            </section>

            <br>

            <section class="card">
                <h2>Categorías registradas</h2>

                {% if categorias %}
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for categoria in categorias %}
                            <tr>
                                <td>{{ categoria.id }}</td>
                                <td>{{ categoria.nombre }}</td>
                                <td>{{ categoria.descripcion }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aún no hay categorías registradas.</p>
                {% endif %}
            </section>

            <footer>
                <p>HelpDesk Lite · Gestión de soporte técnico</p>
            </footer>

        </main>

    </div>

</body>
</html>
