# Crear un producto
@app.route("/crear", methods=["POST"])
def crear_producto():
    nombre = request.form.get("nombre", "").strip()
    descripcion = request.form.get("descripcion", "").strip()

    try:
        precio = float(request.form.get("precio", ""))
        cantidad = int(request.form.get("cantidad", ""))

        if not nombre:
            from flask import flash
            flash("El nombre del producto es obligatorio.")
            return redirect(url_for("index"))

        if len(nombre) > 150 or len(descripcion) > 1000:
            from flask import flash
            flash("El nombre o la descripción superan la longitud permitida.")
            return redirect(url_for("index"))

        if precio < 0 or cantidad < 0:
            from flask import flash
            flash("El precio y la cantidad no pueden ser negativos.")
            return redirect(url_for("index"))

        if precio != precio or precio == float("inf") or precio == float("-inf"):
            from flask import flash
            flash("El precio introducido no es válido.")
            return redirect(url_for("index"))

    except (ValueError, TypeError):
        from flask import flash
        flash("Introduce un precio y una cantidad válidos.")
        return redirect(url_for("index"))

    conexion = conectar_db()

    try:
        conexion.execute("""
            INSERT INTO productos (nombre, descripcion, precio, cantidad)
            VALUES (?, ?, ?, ?)
        """, (nombre, descripcion, precio, cantidad))

        conexion.commit()

    finally:
        conexion.close()

    from flask import flash
    flash("Producto creado correctamente.")
    return redirect(url_for("index"))


# Eliminar un producto
@app.route("/eliminar/<int:id>", methods=["POST"])
def eliminar_producto(id):
    conexion = conectar_db()

    try:
        cursor = conexion.execute(
            "DELETE FROM productos WHERE id = ?",
            (id,)
        )
        conexion.commit()
        eliminado = cursor.rowcount > 0

    finally:
        conexion.close()

    from flask import flash
    if eliminado:
        flash("Producto eliminado correctamente.")
    else:
        flash("El producto no existe.")

    return redirect(url_for("index"))


