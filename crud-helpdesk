@app.route("/")
def inicio():
    conexion = conectar_db()

    estadisticas = conexion.execute("""
        SELECT
            COUNT(*),
            SUM(CASE WHEN estado = 'Abierto' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'En proceso' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'Resuelto' THEN 1 ELSE 0 END)
        FROM tickets
    """).fetchone()

    conexion.close()

    return render_template(
        "index.html",
        total_tickets=estadisticas[0] or 0,
        tickets_abiertos=estadisticas[1] or 0,
        tickets_proceso=estadisticas[2] or 0,
        tickets_resueltos=estadisticas[3] or 0
    )
