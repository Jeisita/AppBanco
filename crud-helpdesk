estado_filtro = request.args.get("estado", "")
prioridad_filtro = request.args.get("prioridad", "")

consulta = """
    SELECT tickets.*, usuarios.nombre AS solicitante,
    categorias.nombre AS categoria
    FROM tickets
    JOIN usuarios ON tickets.usuario_id = usuarios.id
    JOIN categorias ON tickets.categoria_id = categorias.id
    WHERE 1=1
"""

parametros = []

if estado_filtro:
    consulta += " AND tickets.estado = ?"
    parametros.append(estado_filtro)

if prioridad_filtro:
    consulta += " AND tickets.prioridad = ?"
    parametros.append(prioridad_filtro)

consulta += " ORDER BY tickets.id DESC"

lista_tickets = conexion.execute(
    consulta, parametros
).fetchall()
