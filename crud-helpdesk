
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HelpDesk Lite - Dashboard</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>☕ HelpDesk Lite</h2>

            <nav>
                <a href="/" class="active">⌂ Inicio</a>
                <a href="/usuarios">♙ Usuarios</a>
                <a href="/categorias">▤ Categorías</a>
                <a href="/tickets">▣ Tickets</a>
            </nav>
        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Panel principal</h1>
                <p>Bienvenida al sistema de gestión de soporte técnico.</p>
            </header>

            <section class="stats-grid">

                <div class="card">
                    <h3>Total de tickets</h3>
                    <p class="stat-number">{{ total_tickets }}</p>
                </div>

                <div class="card">
                    <h3>Tickets abiertos</h3>
                    <p class="stat-number">{{ tickets_abiertos }}</p>
                </div>

                <div class="card">
                    <h3>En proceso</h3>
                    <p class="stat-number">{{ tickets_proceso }}</p>
                </div>

                <div class="card">
                    <h3>Tickets resueltos</h3>
                    <p class="stat-number">{{ tickets_resueltos }}</p>
                </div>

            </section>

            <footer>
                <p>HelpDesk Lite · Gestión de soporte técnico</p>
            </footer>

        </main>

    </div>

</body>
</html>
