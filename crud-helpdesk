@app.route("/tickets", methods=["GET", "POST"])
def tickets():
    error = ""

    conexion = conectar_db()

    usuarios = conexion.execute(
        "SELECT * FROM usuarios ORDER BY nombre"
    ).fetchall()

    categorias = conexion.execute(
        "SELECT * FROM categorias ORDER BY nombre"
    ).fetchall()

    if request.method == "POST":
        titulo = request.form.get("titulo", "").strip()
        descripcion = request.form.get("descripcion", "").strip()
        prioridad = request.form.get("prioridad")
        usuario_id = request.form.get("usuario_id")
        categoria_id = request.form.get("categoria_id")

        if not titulo or not descripcion or not usuario_id or not categoria_id:
            error = "Debes completar todos los campos."
        else:
            try:
                conexion.execute(
                    """INSERT INTO tickets
                    (titulo, descripcion, prioridad, usuario_id, categoria_id)
                    VALUES (?, ?, ?, ?, ?)""",
                    (titulo, descripcion, prioridad, usuario_id, categoria_id)
                )
                conexion.commit()
                conexion.close()
                return redirect(url_for("tickets"))

            except Exception:
                conexion.rollback()
                error = "No se pudo registrar el ticket."

    lista_tickets = conexion.execute("""
        SELECT tickets.*, usuarios.nombre AS solicitante,
        categorias.nombre AS categoria
        FROM tickets
        JOIN usuarios ON tickets.usuario_id = usuarios.id
        JOIN categorias ON tickets.categoria_id = categorias.id
        ORDER BY tickets.id DESC
    """).fetchall()

    conexion.close()

    return render_template(
        "tickets.html",
        tickets=lista_tickets,
        usuarios=usuarios,
        categorias=categorias,
        error=error
    )
