from flask import Flask, render_template, request, redirect, url_for
from database import conectar_db, crear_tablas

app = Flask(__name__)

crear_tablas()


@app.route("/")
def inicio():
    conexion = conectar_db()

    estadisticas = conexion.execute("""
        SELECT
            COUNT(*),
            SUM(CASE WHEN estado = 'Pendiente' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'Prestado' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'Devuelto' THEN 1 ELSE 0 END)
        FROM prestamos
    """).fetchone()

    conexion.close()

    return render_template(
        "index.html",
        total_prestamos=estadisticas[0] or 0,
        prestamos_pendientes=estadisticas[1] or 0,
        prestamos_activos=estadisticas[2] or 0,
        prestamos_devueltos=estadisticas[3] or 0
    )


@app.route("/solicitantes", methods=["GET", "POST"])
def solicitantes():
    error = ""

    if request.method == "POST":
        nombre = request.form.get("nombre", "").strip()
        correo = request.form.get("correo", "").strip()

        if not nombre or not correo:
            error = "Debes completar todos los campos."
        else:
            conexion = conectar_db()

            try:
                conexion.execute(
                    "INSERT INTO solicitantes (nombre, correo) VALUES (?, ?)",
                    (nombre, correo)
                )

                conexion.commit()

                return redirect(url_for("solicitantes"))

            except Exception:
                conexion.rollback()
                error = "El correo ya existe o los datos no son válidos."

            finally:
                conexion.close()

    conexion = conectar_db()

    lista_solicitantes = conexion.execute(
        "SELECT * FROM solicitantes ORDER BY id DESC"
    ).fetchall()

    conexion.close()

    return render_template(
        "solicitantes.html",
        solicitantes=lista_solicitantes,
        error=error
    )


