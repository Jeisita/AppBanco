<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tipos de equipos - TechLoan</title>

    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>💻 TechLoan</h2>

            <nav>
                <a href="{{ url_for('inicio') }}">▦ Panel de control</a>
                <a href="{{ url_for('solicitantes') }}">👥 Solicitantes</a>
                <a href="{{ url_for('tipos_equipos') }}" class="active">🖥️ Tipos de equipos</a>
                <a href="{{ url_for('prestamos') }}">📋 Préstamos</a>
            </nav>
        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Tipos de equipos tecnológicos</h1>
                <p>Clasifica los equipos que pueden ser solicitados en préstamo.</p>
            </header>

            <section class="card">
                <h2>Registrar tipo de equipo</h2>

                {% if error %}
                    <div class="alert">{{ error }}</div>
                {% endif %}

                <form method="POST">

                    <label>Nombre del tipo de equipo:</label>
                    <input
                        type="text"
                        name="nombre"
                        placeholder="Ej. Portátiles, proyectores, tablets..."
                        required
                    >

                    <label>Descripción:</label>
                    <textarea
                        name="descripcion"
                        rows="4"
                        placeholder="Describe las características del tipo de equipo"
                    ></textarea>

                    <button type="submit">Registrar tipo de equipo</button>

                </form>
            </section>

            <br>

            <section class="card">
                <h2>Tipos de equipos registrados</h2>

                {% if tipos_equipos %}
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tipo de equipo</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for tipo in tipos_equipos %}
                            <tr>
                                <td>{{ tipo.id }}</td>
                                <td>{{ tipo.nombre }}</td>
                                <td>{{ tipo.descripcion }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>No hay tipos de equipos registrados.</p>
                {% endif %}
            </section>

            <footer>
                <p>TechLoan · Gestión de préstamos tecnológicos</p>
            </footer>

        </main>

    </div>

</body>
</html>
