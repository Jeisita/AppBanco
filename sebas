<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Préstamos - TechLoan</title>

    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>💻 TechLoan</h2>

            <nav>
                <a href="{{ url_for('inicio') }}">▦ Panel de control</a>
                <a href="{{ url_for('solicitantes') }}">👥 Solicitantes</a>
                <a href="{{ url_for('tipos_equipos') }}">🖥️ Tipos de equipos</a>
                <a href="{{ url_for('prestamos') }}" class="active">📋 Préstamos</a>
            </nav>
        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Gestión de préstamos</h1>
                <p>Registra y administra las solicitudes de equipos tecnológicos.</p>
            </header>

            <!-- FORMULARIO DE REGISTRO -->

            <section class="card">
                <h2>Nueva solicitud de préstamo</h2>

                {% if error %}
                    <div class="alert">{{ error }}</div>
                {% endif %}

                <form method="POST">

                    <label>Equipo solicitado:</label>
                    <input
                        type="text"
                        name="equipo"
                        placeholder="Ej. Portátil Lenovo ThinkPad"
                        required
                    >

                    <label>Motivo del préstamo:</label>
                    <textarea
                        name="motivo"
                        rows="4"
                        placeholder="Describe para qué necesitas el equipo"
                        required
                    ></textarea>

                    <label>Nivel de urgencia:</label>
                    <select name="urgencia" required>
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                    </select>

                    <label>Solicitante:</label>
                    <select name="solicitante_id" required>
                        <option value="">Seleccionar solicitante</option>

                        {% for persona in solicitantes %}
                            <option value="{{ persona.id }}">
                                {{ persona.nombre }}
                            </option>
                        {% endfor %}
                    </select>

                    <label>Tipo de equipo:</label>
                    <select name="tipo_equipo_id" required>
                        <option value="">Seleccionar tipo de equipo</option>

                        {% for tipo in tipos_equipos %}
                            <option value="{{ tipo.id }}">
                                {{ tipo.nombre }}
                            </option>
                        {% endfor %}
                    </select>

                    <button type="submit">Registrar préstamo</button>

                </form>
            </section>

            <br>

            <!-- FILTROS -->

            <section class="card">
                <h2>Buscar solicitudes</h2>
                <p>Consulta los préstamos según su estado y urgencia.</p>

                <form method="GET" action="{{ url_for('prestamos') }}">

                    <label>Estado del préstamo:</label>
                    <select name="estado">
                        <option value="">Todos</option>

                        {% for estado in ['Pendiente', 'Prestado', 'Devuelto'] %}
                            <option value="{{ estado }}"
                                {% if request.args.get('estado') == estado %}
                                    selected
                                {% endif %}>
                                {{ estado }}
                            </option>
                        {% endfor %}

                    </select>

                    <label>Urgencia:</label>
                    <select name="urgencia">
                        <option value="">Todas</option>

                        {% for urgencia in ['Baja', 'Media', 'Alta'] %}
                            <option value="{{ urgencia }}"
                                {% if request.args.get('urgencia') == urgencia %}
                                    selected
                                {% endif %}>
                                {{ urgencia }}
                            </option>
                        {% endfor %}

                    </select>

                    <button type="submit">Buscar préstamos</button>

                    <a href="{{ url_for('prestamos') }}" class="btn">
                        Limpiar filtros
                    </a>

                </form>
            </section>

            <br>

            <!-- HISTORIAL DE PRESTAMOS -->

            <section class="card">
                <h2>Historial de préstamos</h2>

                {% if prestamos %}

                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Equipo</th>
                                <th>Motivo</th>
                                <th>Urgencia</th>
                                <th>Solicitante</th>
                                <th>Tipo de equipo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for prestamo in prestamos %}

                            <tr>
                                <td>{{ prestamo.id }}</td>
                                <td>{{ prestamo.equipo }}</td>
                                <td>{{ prestamo.motivo }}</td>

                                <td>
                                    <span class="urgencia-{{ prestamo.urgencia | lower }}">
                                        {{ prestamo.urgencia }}
                                    </span>
                                </td>

                                <td>{{ prestamo.solicitante }}</td>
                                <td>{{ prestamo.tipo_equipo }}</td>

                                <td>

                                    <span class="estado-{{ prestamo.estado | lower }}">
                                        {{ prestamo.estado }}
                                    </span>

                                    <form method="POST"
                                          action="{{ url_for('actualizar_estado', prestamo_id=prestamo.id) }}">

                                        <select name="estado">

                                            {% for estado in ['Pendiente', 'Prestado', 'Devuelto'] %}

                                                <option value="{{ estado }}"
                                                    {% if prestamo.estado == estado %}
                                                        selected
                                                    {% endif %}>
                                                    {{ estado }}
                                                </option>

                                            {% endfor %}

                                        </select>

                                        <button type="submit">Actualizar</button>

                                    </form>

                                </td>
                            </tr>

                            {% endfor %}
                        </tbody>
                    </table>

                {% else %}
                    <p>No se encontraron solicitudes de préstamo.</p>
                {% endif %}

            </section>

            <footer>
                <p>TechLoan · Gestión de préstamos tecnológicos</p>
            </footer>

        </main>

    </div>

</body>
</html>
