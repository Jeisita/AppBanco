<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechLoan - Panel de control</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>💻 TechLoan</h2>

            <nav>
                <a href="{{ url_for('inicio') }}" class="active">
                    ▦ Panel de control
                </a>

                <a href="{{ url_for('solicitantes') }}">
                    👥 Solicitantes
                </a>

                <a href="{{ url_for('tipos_equipos') }}">
                    🖥️ Tipos de equipos
                </a>

                <a href="{{ url_for('prestamos') }}">
                    📋 Préstamos
                </a>
            </nav>

        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Control de préstamos</h1>
                <p>Sistema de gestión de préstamos de equipos tecnológicos.</p>
            </header>

            <section class="stats-grid">

                <div class="card">
                    <h3>Total de solicitudes</h3>
                    <p class="stat-number">{{ total_prestamos }}</p>
                </div>

                <div class="card">
                    <h3>Solicitudes pendientes</h3>
                    <p class="stat-number">{{ prestamos_pendientes }}</p>
                </div>

                <div class="card">
                    <h3>Equipos prestados</h3>
                    <p class="stat-number">{{ prestamos_activos }}</p>
                </div>

                <div class="card">
                    <h3>Equipos devueltos</h3>
                    <p class="stat-number">{{ prestamos_devueltos }}</p>
                </div>

            </section>

            <footer>
                <p>TechLoan · Gestión de préstamos tecnológicos</p>
            </footer>

        </main>

    </div>

</body>
</html>
