FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir Flask

RUN apt-get update && apt-get install -y sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY app_helpdesk.py .
COPY database.py .
COPY templates/ templates/
COPY static/ static/

EXPOSE 5001

CMD ["python", "app_helpdesk.py"]
