from flask import Flask, render_template, request, redirect, url_for
from database import conectar_db, crear_tablas

app = Flask(__name__)

crear_tablas()


@app.route("/")
def inicio():
    conexion = conectar_db()

    estadisticas = conexion.execute("""
        SELECT
            COUNT(*),
            SUM(CASE WHEN estado = 'Abierto' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'En proceso' THEN 1 ELSE 0 END),
            SUM(CASE WHEN estado = 'Resuelto' THEN 1 ELSE 0 END)
        FROM tickets
    """).fetchone()

    conexion.close()

    return render_template(
        "index.html",
        total_tickets=estadisticas[0] or 0,
        tickets_abiertos=estadisticas[1] or 0,
        tickets_proceso=estadisticas[2] or 0,
        tickets_resueltos=estadisticas[3] or 0
    )


@app.route("/usuarios", methods=["GET", "POST"])
def usuarios():
    error = ""

    if request.method == "POST":
        nombre = request.form.get("nombre", "").strip()
        correo = request.form.get("correo", "").strip()

        if not nombre or not correo:
            error = "Debes completar todos los campos."
        else:
            conexion = conectar_db()

            try:
                conexion.execute(
                    "INSERT INTO usuarios (nombre, correo) VALUES (?, ?)",
                    (nombre, correo)
                )

                conexion.commit()

                return redirect(url_for("usuarios"))

            except Exception:
                conexion.rollback()
                error = "Ese correo ya existe o los datos no son válidos."

            finally:
                conexion.close()

    conexion = conectar_db()

    lista_usuarios = conexion.execute(
        "SELECT * FROM usuarios ORDER BY id DESC"
    ).fetchall()

    conexion.close()

    return render_template(
        "usuarios.html",
        usuarios=lista_usuarios,
        error=error
    )


