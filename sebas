@app.route("/prestamos", methods=["GET", "POST"])
def prestamos():
    error = ""

    conexion = conectar_db()

    solicitantes = conexion.execute(
        "SELECT * FROM solicitantes ORDER BY nombre"
    ).fetchall()

    tipos_equipos = conexion.execute(
        "SELECT * FROM tipos_equipos ORDER BY nombre"
    ).fetchall()

    if request.method == "POST":
        equipo = request.form.get("equipo", "").strip()
        motivo = request.form.get("motivo", "").strip()
        urgencia = request.form.get("urgencia")
        solicitante_id = request.form.get("solicitante_id")
        tipo_equipo_id = request.form.get("tipo_equipo_id")

        if not equipo or not motivo or not solicitante_id or not tipo_equipo_id:
            error = "Debes completar todos los campos."

        elif urgencia not in ["Baja", "Media", "Alta"]:
            error = "Selecciona una urgencia válida."

        else:
            try:
                conexion.execute("""
                    INSERT INTO prestamos
                    (equipo, motivo, urgencia, solicitante_id, tipo_equipo_id)
                    VALUES (?, ?, ?, ?, ?)
                """, (
                    equipo,
                    motivo,
                    urgencia,
                    solicitante_id,
                    tipo_equipo_id
                ))

                conexion.commit()
                conexion.close()

                return redirect(url_for("prestamos"))

            except Exception:
                conexion.rollback()
                error = "No se pudo registrar el préstamo."

    # Filtros de préstamos
    estado_filtro = request.args.get("estado", "")
    urgencia_filtro = request.args.get("urgencia", "")

    consulta = """
        SELECT
            prestamos.*,
            solicitantes.nombre AS solicitante,
            tipos_equipos.nombre AS tipo_equipo
        FROM prestamos
        INNER JOIN solicitantes
            ON prestamos.solicitante_id = solicitantes.id
        INNER JOIN tipos_equipos
            ON prestamos.tipo_equipo_id = tipos_equipos.id
        WHERE 1=1
    """

    parametros = []

    if estado_filtro:
        consulta += " AND prestamos.estado = ?"
        parametros.append(estado_filtro)

    if urgencia_filtro:
        consulta += " AND prestamos.urgencia = ?"
        parametros.append(urgencia_filtro)

    consulta += " ORDER BY prestamos.id DESC"

    lista_prestamos = conexion.execute(
        consulta,
        parametros
    ).fetchall()

    conexion.close()

    return render_template(
        "prestamos.html",
        prestamos=lista_prestamos,
        solicitantes=solicitantes,
        tipos_equipos=tipos_equipos,
        error=error
    )


@app.route("/prestamos/<int:prestamo_id>/estado", methods=["POST"])
def actualizar_estado(prestamo_id):

    nuevo_estado = request.form.get("estado")

    estados_validos = ["Pendiente", "Prestado", "Devuelto"]

    if nuevo_estado not in estados_validos:
        return redirect(url_for("prestamos"))

    conexion = conectar_db()

    conexion.execute(
        "UPDATE prestamos SET estado = ? WHERE id = ?",
        (nuevo_estado, prestamo_id)
    )

    conexion.commit()
    conexion.close()

    return redirect(url_for("prestamos"))


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5001, debug=False)
