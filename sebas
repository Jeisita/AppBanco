/* =================================
   TECHLOAN - ESTILO TECNOLÓGICO
================================= */

:root {
    --azul-oscuro: #0F172A;
    --azul: #2563EB;
    --azul-hover: #1D4ED8;
    --celeste: #38BDF8;
    --fondo: #F1F5F9;
    --blanco: #FFFFFF;
    --texto: #334155;
    --secundario: #64748B;
    --borde: #E2E8F0;
    --sombra: 0 4px 15px rgba(15, 23, 42, 0.08);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--fondo);
    color: var(--texto);
}

/* Estructura principal */

.layout {
    display: flex;
    min-height: 100vh;
}

/* Menú lateral */

.sidebar {
    width: 250px;
    min-height: 100vh;
    background: var(--azul-oscuro);
    padding: 30px 18px;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    overflow-y: auto;
}

.sidebar h2 {
    color: var(--blanco);
    font-size: 24px;
    text-align: center;
    margin: 0 0 40px;
}

.sidebar a {
    display: block;
    padding: 14px 16px;
    margin-bottom: 10px;
    color: #CBD5E1;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: 0.2s;
}

.sidebar a:hover,
.sidebar a.active {
    background: var(--azul);
    color: var(--blanco);
}

/* Contenido principal */

.main-content {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 35px;
}

h1, h2, h3 {
    color: var(--azul-oscuro);
}

.page-header {
    margin-bottom: 30px;
}

.page-header h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

.page-header p {
    color: var(--secundario);
}

/* Tarjetas */

.card {
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--sombra);
    overflow-x: auto;
    transition: box-shadow 0.2s;
}

.card:hover {
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.12);
}

/* Estadísticas */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 20px;
}

.stats-grid .card {
    border-top: 4px solid var(--azul);
}

.stats-grid h3 {
    font-size: 16px;
    color: var(--secundario);
}

.stat-number {
    font-size: 36px;
    font-weight: 700;
    color: var(--azul);
    margin: 15px 0;
}

/* Formularios */

input,
select,
textarea {
    width: 100%;
    padding: 12px 14px;
    margin: 8px 0 18px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: #F8FAFC;
    color: var(--texto);
    font: inherit;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid var(--celeste);
    border-color: var(--azul);
}

label {
    font-weight: 600;
    color: var(--azul-oscuro);
}

/* Botones */

button,
.btn {
    display: inline-block;
    padding: 11px 19px;
    border: none;
    border-radius: 8px;
    background: var(--azul);
    color: var(--blanco);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: 0.2s;
}

button {
    margin-top: 5px;
}

button:hover,
.btn:hover {
    background: var(--azul-hover);
}

/* Tablas */

table {
    width: 100%;
    min-width: 550px;
    border-collapse: collapse;
    background: var(--blanco);
}

th {
    background: #E2E8F0;
    color: var(--azul-oscuro);
    text-align: left;
}

th, td {
    padding: 14px;
    border-bottom: 1px solid var(--borde);
}

tr:hover td {
    background: #F8FAFC;
}

td form {
    min-width: 150px;
}

td select {
    min-width: 130px;
}

/* Mensajes de error */

.alert {
    padding: 14px 16px;
    margin-bottom: 18px;
    border-radius: 8px;
    background: #FEE2E2;
    color: #991B1B;
}

/* Etiquetas de urgencia y estado */

.urgencia-alta,
.urgencia-media,
.urgencia-baja,
.estado-pendiente,
.estado-prestado,
.estado-devuelto {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.urgencia-alta {
    background: #FEE2E2;
    color: #B91C1C;
}

.urgencia-media {
    background: #FEF3C7;
    color: #92400E;
}

.urgencia-baja {
    background: #DCFCE7;
    color: #166534;
}

.estado-pendiente {
    background: #FEF3C7;
    color: #92400E;
}

.estado-prestado {
    background: #DBEAFE;
    color: #1D4ED8;
}

.estado-devuelto {
    background: #DCFCE7;
    color: #166534;
}

/* Pie de página */

footer {
    margin-top: 35px;
    padding: 15px;
    text-align: center;
    color: var(--secundario);
    font-size: 13px;
}

/* Diseño adaptable a dispositivos móviles */

@media (max-width: 700px) {

    .layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        position: relative;
    }

    .sidebar nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .sidebar a {
        margin: 4px;
    }

    .main-content {
        margin-left: 0;
        width: 100%;
        padding: 20px;
    }

    .page-header h1 {
        font-size: 24px;
    }
}
