<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitantes - TechLoan</title>

    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <div class="layout">

        <aside class="sidebar">
            <h2>💻 TechLoan</h2>

            <nav>
                <a href="{{ url_for('inicio') }}">▦ Panel de control</a>
                <a href="{{ url_for('solicitantes') }}" class="active">👥 Solicitantes</a>
                <a href="{{ url_for('tipos_equipos') }}">🖥️ Tipos de equipos</a>
                <a href="{{ url_for('prestamos') }}">📋 Préstamos</a>
            </nav>
        </aside>

        <main class="main-content">

            <header class="page-header">
                <h1>Gestión de solicitantes</h1>
                <p>Administra las personas autorizadas para solicitar equipos tecnológicos.</p>
            </header>

            <section class="card">
                <h2>Nuevo solicitante</h2>

                {% if error %}
                    <div class="alert">{{ error }}</div>
                {% endif %}

                <form method="POST">

                    <label>Nombre completo:</label>
                    <input
                        type="text"
                        name="nombre"
                        placeholder="Nombre del solicitante"
                        required
                    >

                    <label>Correo electrónico:</label>
                    <input
                        type="email"
                        name="correo"
                        placeholder="persona@correo.com"
                        required
                    >

                    <button type="submit">Registrar solicitante</button>

                </form>
            </section>

            <br>

            <section class="card">
                <h2>Directorio de solicitantes</h2>

                {% if solicitantes %}
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre completo</th>
                                <th>Correo electrónico</th>
                                <th>Fecha de registro</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for solicitante in solicitantes %}
                            <tr>
                                <td>{{ solicitante.id }}</td>
                                <td>{{ solicitante.nombre }}</td>
                                <td>{{ solicitante.correo }}</td>
                                <td>{{ solicitante.fecha_registro }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>No hay solicitantes registrados.</p>
                {% endif %}
            </section>

            <footer>
                <p>TechLoan · Gestión de préstamos tecnológicos</p>
            </footer>

        </main>

    </div>

</body>
</html>
