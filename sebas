/* =================================
   HELPDESK LITE - ROSE CAFÉ
================================= */

:root {
    --rosa-nude: #F7E9E7;
    --rosa-viejo: #D8A7A0;
    --terracota: #A87569;
    --cafe: #8B6558;
    --beige: #E8D7C8;
    --crema: #FFF9F5;
    --texto: #59443D;
    --blanco: #FFFFFF;
    --sombra: 0 4px 14px rgba(139, 101, 88, 0.10);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--crema);
    color: var(--texto);
}

/* Estructura principal */

.layout {
    display: flex;
    min-height: 100vh;
}

/* Menú lateral */

.sidebar {
    width: 250px;
    min-height: 100vh;
    background: var(--rosa-nude);
    padding: 28px 18px;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
}

.sidebar h2 {
    color: var(--cafe);
    text-align: center;
    margin: 0 0 35px;
}

.sidebar a {
    display: block;
    padding: 13px 16px;
    margin-bottom: 9px;
    color: var(--cafe);
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: 0.2s;
}

.sidebar a:hover,
.sidebar a.active {
    background: var(--rosa-viejo);
    color: var(--blanco);
}

/* Contenido */

.main-content {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 35px;
}

h1, h2, h3 {
    color: var(--cafe);
}

.page-header {
    margin-bottom: 25px;
}

/* Tarjetas */

.card {
    background: var(--blanco);
    border: 1px solid var(--beige);
    border-radius: 14px;
    padding: 22px;
    box-shadow: var(--sombra);
}

/* Estadísticas */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
}

.stat-number {
    font-size: 32px;
    font-weight: 700;
    color: var(--terracota);
}

/* Formularios */

input,
select,
textarea {
    width: 100%;
    padding: 11px 13px;
    margin: 7px 0 16px;
    border: 1px solid var(--beige);
    border-radius: 9px;
    background: var(--crema);
    color: var(--texto);
    font: inherit;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid var(--rosa-viejo);
    border-color: var(--terracota);
}

label {
    font-weight: 600;
    color: var(--cafe);
}

/* Botones */

button,
.btn {
    display: inline-block;
    padding: 11px 18px;
    border: none;
    border-radius: 9px;
    background: var(--rosa-viejo);
    color: var(--blanco);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: 0.2s;
}

button:hover,
.btn:hover {
    background: var(--terracota);
}

/* Tablas */

table {
    width: 100%;
    border-collapse: collapse;
    background: var(--blanco);
    border-radius: 12px;
    overflow: hidden;
}

th {
    background: var(--rosa-nude);
    color: var(--cafe);
    text-align: left;
}

th, td {
    padding: 13px;
    border-bottom: 1px solid var(--beige);
}

tr:hover td {
    background: #FFFCFA;
}

/* Mensajes */

.alert {
    padding: 13px 16px;
    margin-bottom: 18px;
    border-radius: 9px;
    background: var(--rosa-nude);
    color: var(--cafe);
}

/* Adaptación a pantallas pequeñas */

@media (max-width: 700px) {
    .sidebar {
        width: 100%;
        min-height: auto;
        position: relative;
    }

    .layout {
        display: block;
    }

    .main-content {
        margin-left: 0;
        width: 100%;
        padding: 20px;
    }
}

/* =================================
   DETALLES VISUALES ROSE CAFÉ
================================= */

/* Encabezados de página */

.page-header h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

.page-header p {
    color: var(--cafe);
    opacity: 0.85;
}

/* Tarjetas con efecto suave */

.card {
    transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
    box-shadow: 0 6px 18px rgba(139, 101, 88, 0.15);
}

/* Tablas adaptables */

.card {
    overflow-x: auto;
}

table {
    min-width: 550px;
}

/* Formularios dentro de tablas */

td form {
    min-width: 150px;
}

td select {
    min-width: 130px;
}

/* Prioridades */

.prioridad-alta {
    background: #F3D2CC;
    color: #934D40;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.prioridad-media {
    background: #F2E5D2;
    color: #8B6558;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.prioridad-baja {
    background: #F7E9E7;
    color: #A87569;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

/* Estados de tickets */

.estado-abierto {
    background: #F3D2CC;
    color: #934D40;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.estado-proceso {
    background: #F2E5D2;
    color: #8B6558;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

.estado-resuelto {
    background: #E7EDE3;
    color: #58734F;
    padding: 5px 10px;
    border-radius: 20px;
    font-weight: 600;
}

/* Pie de página */

footer {
    margin-top: 35px;
    padding: 15px;
    text-align: center;
    color: var(--cafe);
    opacity: 0.75;
    font-size: 13px;
}

/* Menú lateral */

.sidebar {
    box-shadow: 3px 0 12px rgba(139, 101, 88, 0.06);
}

.sidebar h2 {
    font-size: 21px;
}

/* Espaciado de botones */

button {
    margin-top: 5px;
}

/* Ajustes para móviles */

@media (max-width: 700px) {
    .sidebar {
        box-shadow: none;
    }

    .sidebar nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .sidebar a {
        margin: 4px;
    }

    .page-header h1 {
        font-size: 24px;
    }
}
